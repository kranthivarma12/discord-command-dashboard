# =================================================================
# Discord InterOps Gateway & Admin Console - Environment Variables
# =================================================================

# Server Port (Default: 3000)
PORT=3000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV="production"

# Application Public Host URL (Used for Discord interactions & webhooks)
APP_URL="https://your-domain.up.railway.app"

# -----------------------------------------------------------------
# Database Configuration (PostgreSQL: Neon, Supabase, Cloud SQL, or PGlite)
# -----------------------------------------------------------------
# Required in production. In development, leaving this empty will use
# embedded PGlite for local testing without external infrastructure.
# Examples:
# Neon: postgresql://user:password@ep-sample-123.us-east-2.aws.neon.tech/neondb?sslmode=require
# Supabase: postgresql://postgres:password@db.abcdefghijklmnopqrst.supabase.co:5432/postgres
DATABASE_URL=""

# -----------------------------------------------------------------
# Session & Security Credentials
# -----------------------------------------------------------------
# SESSION_SECRET: Required in production. Secret key used for signing session JWTs and cookies.
# Must be a high-entropy string (at least 32 characters long).
# Application startup will fail if this is missing in production.
SESSION_SECRET=""

# Default Administrator Account Provisioning:
# Required to seed the initial administrator account if no admin accounts exist.
# The application will never automatically create an account with a default or predictable password.
ADMIN_DEFAULT_USER=""
ADMIN_DEFAULT_PASSWORD=""

# -----------------------------------------------------------------
# Production CORS Configuration
# -----------------------------------------------------------------
# CLIENT_ORIGIN: Required in production if frontend is hosted on a separate domain.
# Comma-separated list of allowed origins (e.g. "https://admin.yourdomain.com").
# In development, localhost is permitted automatically.
# Discord Interactions endpoint (/api/discord/interactions) is publicly reachable
# and secured by Ed25519 signature verification rather than browser CORS.
CLIENT_ORIGIN=""

# -----------------------------------------------------------------
# Discord Developer Application Settings
# -----------------------------------------------------------------
# Found in: https://discord.com/developers/applications
DISCORD_APPLICATION_ID=""
DISCORD_PUBLIC_KEY=""
DISCORD_BOT_TOKEN=""
DISCORD_GUILD_ID=""
DISCORD_TARGET_CHANNEL_ID=""

# -----------------------------------------------------------------
# Downstream Mirror Notification Destination
# -----------------------------------------------------------------
# Discord Webhook URL or Slack Incoming Webhook URL
MIRROR_DESTINATION_URL=""
MIRROR_DESTINATION_TYPE="discord_webhook"
MIRROR_ENABLED=true
MIRROR_MAX_RETRIES=3
MIRROR_RETRY_BACKOFF_MS=1000

# -----------------------------------------------------------------
# Optional AI Enhancement (Gemini API)
# -----------------------------------------------------------------
# Optional: Used for AI report classification or summarization
GEMINI_API_KEY=""
